# ============================================================
# WebSSH 配置示例：复制为 .env 后按需修改
#   cp .env.example .env
# ============================================================

# ---------- Docker Compose 端口 ----------
# 默认只绑定回环地址；需要局域网直连时改为 0.0.0.0
# WEBSSH_BIND=127.0.0.1
# WEBSSH_PORT=3000

# ---------- 基础 ----------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# 部署在 Nginx / Caddy 之后时设为 true，才能正确取到客户端真实 IP（用于登录限流）
TRUST_PROXY=false

# /api 通用限流（每 IP 每分钟），0 表示关闭
HTTP_RATE_LIMIT_PER_MIN=300

# 反向代理后强制 HTTPS（依据 X-Forwarded-Proto 做 308 跳转）
FORCE_HTTPS=false

# 数据目录（known_hosts、审计日志），容器挂载或测试时可覆盖
# DATA_DIR=./data

# 跨域白名单（逗号分隔）。留空则按请求 Host 同源校验，通常无需填写。
# ALLOWED_ORIGINS=https://ssh.example.com

# ---------- 登录认证 ----------
# 单账号模式（未创建用户文件时生效）
WEBSSH_USER=admin

# 方式一：明文口令（简单，但会以明文出现在环境变量中）
WEBSSH_PASS=CHANGE_ME_BEFORE_DEPLOY

# 方式二（推荐）：scrypt 哈希，执行 `npm run hash` 生成后填在这里；
# 配置后 WEBSSH_PASS 将被忽略。
# WEBSSH_PASS_HASH=scrypt$65536$8$1$...$...

# 多用户模式（推荐）：用户文件存在时优先生效，支持角色与禁用状态。
# 用 `npm run user -- add <name> --role <admin|operator|developer|auditor>` 维护。
# WEBSSH_USERS_FILE=./data/users.json

# 新口令哈希的 scrypt 成本（2 的幂，默认 2^16，约 64MB 内存/次）
# SCRYPT_N=65536

# 打开部署机终端前的二次身份认证（step-up）
STEP_UP_FOR_LOCAL=true
STEP_UP_TTL_MINUTES=5

# 登录票据签名密钥，务必修改为随机值：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 密钥环（逗号分隔）：首个用于签发，其余用于验证；轮换期间可新旧并存
# SESSION_SECRETS=new-secret,old-secret
SESSION_TTL_MINUTES=480
# 票据绑定进程实例标识：服务重启后所有登录态自动失效，需要重新登录
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=10

# ---------- 可观测性 ----------
LOG_FORMAT=text
# LOG_FORMAT=json 时输出结构化日志，便于 ELK / Loki 解析
METRICS_ENABLED=true
# 设置后访问 /metrics 需带 Authorization: Bearer <token>
# METRICS_TOKEN=

# ---------- TLS ----------
# 配置后服务直接以 HTTPS + WSS 运行；未配置则建议由反向代理终结 TLS
# TLS_KEY=/etc/ssl/private/webssh.key
# TLS_CERT=/etc/ssl/certs/webssh.crt
# COOKIE_SECURE=true

# ---------- 会话 ----------
MAX_SESSIONS=100
MAX_SESSIONS_PER_USER=10
# 前端断线后，服务端保留 SSH 会话供重连的时长（秒）
RESUME_GRACE_SECONDS=120
# 无操作自动断开（分钟），0 表示不限制
IDLE_TIMEOUT_MINUTES=0
# 重连时回放给前端的输出缓冲（KB）
REPLAY_BUFFER_KB=256
SCROLLBACK_LINES=5000

# ---------- 部署机终端（本机 PTY） ----------
# 是否允许在浏览器中直接打开部署机器的 Shell（权限等同服务运行账号）
LOCAL_TERMINAL_ENABLED=true
# 留空则自动探测：Linux 取 $SHELL 或 /bin/bash；Windows 取 pwsh / 系统自带 PowerShell / COMSPEC
# LOCAL_TERMINAL_SHELL=/bin/bash
# LOCAL_TERMINAL_ARGS=-l
# LOCAL_TERMINAL_CWD=/opt/app
LOCAL_TERMINAL_MAX_SESSIONS=2
# 进程树资源看门狗（仅 Linux 生效）：进程数与常驻内存上限，超限自动终止会话
LOCAL_TERMINAL_MAX_PROCS=200
LOCAL_TERMINAL_MAX_MEMORY_MB=1024
LOCAL_TERMINAL_WATCH_INTERVAL_MS=5000
# 额外允许传入本机 Shell 的环境变量（逗号分隔）。默认使用白名单，避免第三方密钥泄漏。
# LOCAL_TERMINAL_ENV_ALLOW=JAVA_HOME,HTTP_PROXY

# ---------- 操作审计 ----------
AUDIT_LOG_ENABLED=true
# 是否记录本机会话提交的命令行（按原文记录，注意避免在命令中写明文密钥）
AUDIT_RECORD_COMMANDS=true
# 密码 / 口令提示处的输入是否屏蔽（推荐 true）
AUDIT_REDACT_SECRET_PROMPTS=true
# 哈希链：每条记录带 seq/prev/hash，可用 GET /api/audit/verify 校验是否被篡改
AUDIT_HASH_CHAIN=true
# 哈希链密钥，留空则从 SESSION_SECRET 派生
# AUDIT_CHAIN_KEY=
# AUDIT_LOG_FILE=./data/audit.log
AUDIT_MAX_FILE_MB=10
# 审计批量 fsync 间隔（毫秒），0 表示不主动 fsync
AUDIT_FSYNC_MS=1000
AUDIT_KEEP_FILES=5
AUDIT_MEMORY_ENTRIES=500

# 远端投递（推荐）：批量 POST JSON 事件到 SIEM / 日志网关
# AUDIT_FORWARD_URL=https://siem.example.com/ingest/webssh
# AUDIT_FORWARD_TOKEN=
# AUDIT_REQUIRE_DELIVERY=true 时，投递连续失败将拒绝新建本机终端（fail-closed）
AUDIT_REQUIRE_DELIVERY=false
AUDIT_FORWARD_TIMEOUT_MS=5000
AUDIT_FORWARD_BATCH=100
AUDIT_FORWARD_QUEUE_MAX=5000
# 可选 UDP syslog 旁路（只发送，不参与健康判定）
# AUDIT_SYSLOG_HOST=10.0.0.10
# AUDIT_SYSLOG_PORT=514

# ---------- SSH ----------
SSH_CONNECT_TIMEOUT_MS=20000
SSH_READY_TIMEOUT_MS=20000
SSH_KEEPALIVE_MS=15000
SSH_KEEPALIVE_COUNT=3
# true = 只允许连接 known_hosts 中已记录指纹的主机（更严格）
SSH_STRICT_HOST_KEY=false
# true = 禁止连接内网 / 保留地址（服务对公网开放时建议开启）
SSH_BLOCK_PRIVATE_HOSTS=false
# KNOWN_HOSTS_FILE=./data/known_hosts.json

# ---------- 会话录像（asciinema v2） ----------
# 记录终端输出（不含键盘输入），用于事后回放与取证
RECORDING_ENABLED=true
# RECORDING_DIR=./data/recordings
RECORDING_MAX_MB=50
RECORDING_KEEP_DAYS=30

# ---------- WebSocket ----------
WS_MAX_PAYLOAD_KB=256
WS_MAX_CONN_PER_IP=20
WS_MAX_MSG_PER_SECOND=400
